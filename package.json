{
  "name": "jinli-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/shared", "packages/core", "server"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run typecheck && npm run build -w @jinli/server",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.view.json",
    "lint": "eslint .",
    "test": "vitest run",
    "scan": "tsx tools/scan-wordlist.ts",
    "sync-client": "tsx tools/sync-client.ts",
    "sync-check": "tsx tools/sync-client.ts --check",
    "ci": "tsx tools/ci.ts",
    "verify-pack": "tsx tools/verify-pack.ts",
    "loadtest": "tsx tools/loadtest.ts",
    "soak": "tsx --expose-gc tools/soak.ts",
    "softcopyright": "tsx tools/softcopyright-pdf.ts",
    "dev:server": "tsx server/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pdfkit": "0.13.8",
    "@types/ws": "8.5.13",
    "esbuild": "0.24.0",
    "eslint": "9.17.0",
    "pdfkit": "0.15.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "vitest": "2.1.8"
  }
}
